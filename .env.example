# Optional: used when the UI API key field is empty.
IDEOGRAM_API_KEY=

# Optional: needed to download gated Ideogram 4 weights for local CUDA mode.
HF_TOKEN=

# Local open-weight runtime settings.
IDEOGRAM_QUANTIZATION=nf4
IDEOGRAM_DEVICE=cuda
IDEOGRAM_HF_CACHE=
IDEOGRAM_OUTPUT_DIR=runtime/outputs
